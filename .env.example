# ITDroid local LLM translation configuration.
#
# Copy this file to ".env" (same folder you pass as settingsDir) and adjust the values.
# All settings can also be provided as environment variables or JVM system properties
# (-Dkey=value); precedence is system property, then environment variable, then .env.
#
# The translator talks to a local LLM through an OpenAI-compatible HTTP endpoint, so it
# works with Ollama, llama.cpp's llama-server, LM Studio, etc., on CPU-only machines.
#
# Quick start with Ollama (recommended):
#   1. Install Ollama: https://ollama.com/download
#   2. Pull a small multilingual model: ollama pull qwen2.5:3b
#   3. Ollama serves the endpoint automatically at http://localhost:11434
#
# Alternative, llama.cpp:
#   Run: llama-server -m <model>.gguf --port 11434
#   Then set ITDROID_LLM_ENDPOINT=http://localhost:11434/v1/chat/completions
#
# Letting ITDroid start the LLM for you (optional 8th CLI argument):
#   * Ollama model name (bare token, e.g. qwen2.5:3b): ITDroid starts `ollama serve` if
#     needed, `ollama pull`s the model (downloads it if you don't have it) and uses it,
#     overriding the ENDPOINT/MODEL below to point at Ollama.
#   * Launch command (with spaces, e.g. "ollama serve" or "llama-server -m model.gguf --port 8080"):
#     ITDroid runs it and waits until the ENDPOINT below answers.
#   If you pass nothing, the server must already be running or the run aborts with a clear error.
#   A server ITDroid starts is stopped at the end; one you already had running is reused.

# Full URL of the chat-completions endpoint.
ITDROID_LLM_ENDPOINT=http://localhost:11434/v1/chat/completions

# Model name as known by the runtime (e.g. qwen2.5:3b, qwen2.5:7b, gemma2:2b, llama3.2:3b).
ITDROID_LLM_MODEL=qwen2.5:3b

# Optional API key. Ollama ignores it; some servers (LM Studio, gateways) may require it.
ITDROID_LLM_API_KEY=

# Per-request timeout in seconds (CPU inference can be slow; raise for big batches).
ITDROID_LLM_TIMEOUT=180

# Sampling temperature. 0 gives the most deterministic, faithful translations.
ITDROID_LLM_TEMPERATURE=0
