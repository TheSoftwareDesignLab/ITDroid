# apktool decode/build output and run artifacts (regenerated on every run)
temp/

# External binaries: not source — download into extra/ per the README
extra/*.jar

# Avoid ignoring Maven wrapper jar file (.jar files are usually ignored)
!/.mvn/wrapper/maven-wrapper.jar

# Local APKs and evaluation results, not versioned
eval/

# Evaluations written by ITDroid (served by: java -jar target/ITDroid-1.0.0.jar --report)
results/

# Output of: java -jar target/ITDroid-1.0.0.jar --reanalyze <folder>
reanalysis/
